OpenGL 2 drivers (the iPad's SGX: OpenGL 2.1): SDL_GL_CreateContext's
failure is thrown, not carried on into epoxy's "no current context"
abort; the GL_INVALID_ENUM SDL's EGL path leaves (glGetIntegerv of
GL_MAJOR_VERSION on a GL 2 context) is cleared; and opengl_auto falls
back to the OpenGL 2.0 renderer before the SDL one.

--- a/src/video/gl/gl_video_system.cpp
+++ b/src/video/gl/gl_video_system.cpp
@@ -225,7 +225,13 @@
 GLVideoSystem::create_gl_context()
 {
   m_glcontext = SDL_GL_CreateContext(m_sdl_window.get());
+  if (!m_glcontext)
+    throw std::runtime_error(std::string("SDL_GL_CreateContext failed: ") + SDL_GetError());
 
+  // SDL's EGL path (SDL_HINT_VIDEO_X11_FORCE_EGL, set for epoxy) asks a
+  // desktop context for GL_MAJOR_VERSION, which OpenGL 2 does not have: the
+  // GL_INVALID_ENUM left behind is SDL's, not ours.
+  for (int i = 0; i < 8 && glGetError() != GL_NO_ERROR; i++) {}
   assert_gl();
   set_vsync(g_config->vsync);
   assert_gl();
--- a/src/video/video_system.cpp
+++ b/src/video/video_system.cpp
@@ -61,9 +61,18 @@
       {
         return std::make_unique<GLVideoSystem>(true, true);
       }
+      catch(std::exception& err)
+      {
+        // (a driver with OpenGL 2 only has no 3.3 core context to give)
+        log_warning << "Error creating GLVideoSystem, trying GLVideoSystem-20: "  << err.what() << std::endl;
+      }
+      try
+      {
+        return std::make_unique<GLVideoSystem>(false, false);
+      }
       catch(std::exception& err2)
       {
-        log_warning << "Error creating GLVideoSystem, using SDL fallback: "  << err2.what() << std::endl;
+        log_warning << "Error creating GLVideoSystem-20, using SDL fallback: "  << err2.what() << std::endl;
         return std::make_unique<SDLVideoSystem>();
       }
 #endif
