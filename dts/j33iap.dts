/dts-v1/;

/*
 * Apple TV 3rd generation, Rev A: AppleTV3,2 / J33iAP / S5L8947X (one core).
 *
 * Derived from p105ap.dts: the SoC blocks used here sit at the same
 * addresses on J33i (decrypted 12H847 ADT, and the live IODeviceTree read
 * over ssh from iOS 8.4.4).  What differs:
 *   - one Cortex-A9, no cpu1;
 *   - the scanout is HDMI through rgbout (0x3a200000), not a panel: the
 *     live ADT /vram is 0x9F570000 + 0xA8C000, iOS runs 1080p, iBoot 720p;
 *   - DRAM is 0x80000000 + 0x1F570000 (hw.memsize), /vram right above it;
 *   - the boot console is uart3 (0x32800000).  uart0 talks to the IR/LED
 *     MCU here, so nothing in this file touches it.
 * HDMI audio: sound/soc/apple/s5l-hdmi.c, docs/research/j33i-audio.md.
 */

/ {
	compatible = "apple,j33iap", "apple,s5l8947x", "apple,s5l8940x", "apple,arm";
	model = "Apple TV (AppleTV3,2)";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&aic>;

	aliases {
		serial0 = &uart3;
		serial1 = &uart1;
	};

	chosen {
		bootargs = "earlycon=s3c6400,0x32800000 keep_bootcon lpj=5000000 root=/dev/ram0 rw rootwait panic=10 loglevel=8 ignore_loglevel g_cdc.host_addr=02:10:5a:05:00:01 g_cdc.dev_addr=02:10:5a:05:00:02";
		linux,initrd-start = <0x88000000>;
		linux,initrd-end   = <0x88000000>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x1f570000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		fb_region: framebuffer@9f570000 {
			reg = <0x9f570000 0xa8c000>;
			no-map;
		};

		cpu_reset_page: cpu-reset@80000000 {
			reg = <0x80000000 0x1000>;
			no-map;
		};
	};

	/* iBoot's HDMI scanout.  Base and stride are patched by the staging
	 * loader from rgbout; 1280x720 is what iBoot Recovery shows over HDMI. */
	framebuffer0: framebuffer@9f570000 {
		compatible = "simple-framebuffer";
		reg = <0x9f570000 0xa8c000>;
		width = <1280>;
		height = <720>;
		stride = <5120>;
		format = "a8r8g8b8";
		memory-region = <&fb_region>;
		status = "okay";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		apple,cpu-reset-page = <&cpu_reset_page>;

		cpu0: cpu@a00 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0xa00>;
		};
	};

	l2: cache-controller@3e000000 {
		compatible = "arm,pl310-cache";
		reg = <0x3e000000 0x1000>, <0x3fd00000 0x2000>;
		cache-unified;
		cache-level = <2>;
		arm,tag-latency = <2 2 1>;
		arm,data-latency = <3 2 1>;
		arm,shared-override;
		arm,full-line-zero-disable;
		arm,dynamic-clock-gating = <1>;
		arm,standby-mode = <0>;
		status = "okay";
	};

	uart_clk: clock-24000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	soc: soc@30000000 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x30000000 0x10000000>;

		aic: interrupt-controller@f200000 {
			compatible = "aic,1";
			reg = <0xf200000 0x10000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			#address-cells = <0>;
			apple,main-cpus = <2>;
		};

		gpio: gpio@fa00000 {
			compatible = "apple,s5l8940x-gpio";
			reg = <0xfa00000 0x100000>;
			interrupts = <119>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			#address-cells = <0>;
			pin-count = <224>;
			interrupt-groups = <1>;
			status = "okay";

			/* UART2, the Bluetooth chip's: TX 18, RX 19, RTS 20, CTS 21 (ADT uart2
			 * function-tx 0x0202, function-rts 0x0204: port 2, pins 2 and 4). */
			uart2_pins: uart2-pins {
				pins = "gpio18", "gpio19", "gpio20", "gpio21";
				function = "periph";
			};
		};

		/* UART1: the TI MSP430 that receives the IR remote and drives the front LED (ADT mcu0,
		 * uart-comm "mcu-comm0"). 250000 8N1, CRC-16 framed (docs/research/j33i-mcu-protocol.md).
		 * No pinctrl: the pins stay as iOS left them. uart0 is the MCU's bootloader link and
		 * GPIO 0/1 its reset/test lines: never enable or touch those. */
		uart1: serial@2600000 {
			compatible = "apple,s5l8940x-uart", "apple,s5l-uart", "samsung,s3c6400-uart";
			reg = <0x2600000 0x1000>;
			interrupts = <22>;
			clocks = <&uart_clk>, <&uart_clk>;
			clock-names = "uart", "clk_uart_baud0";
			status = "okay";

			mcu {
				compatible = "apple,j33i-mcu";	/* arch/arm/mach-apple/atv_mcu.c */
			};
		};

		/* UART2: the BCM4334's Bluetooth half (ADT uart2/bluetooth "n88", module Monopoly OS,
		 * patchram cut from BlueTool). iOS runs it at 3 Mbaud; 24 MHz / 16 caps us at 1.5. */
		uart2: serial@2700000 {
			compatible = "apple,s5l8940x-uart", "apple,s5l-uart", "samsung,s3c6400-uart";
			reg = <0x2700000 0x1000>;
			interrupts = <23>;
			clocks = <&uart_clk>, <&uart_clk>;
			clock-names = "uart", "clk_uart_baud0";
			pinctrl-names = "default";
			pinctrl-0 = <&uart2_pins>;
			status = "okay";

			bluetooth {
				compatible = "brcm,bcm4334-bt";
				shutdown-gpios = <&gpio 104 0>;		/* function-power_enable 0x0d00 */
				device-wakeup-gpios = <&gpio 105 0>;	/* function-bt_wake 0x0d01 */
				max-speed = <1500000>;
				local-bd-address = [00 00 00 00 00 00];	/* your board's own address */
			};
		};

		uart3: serial@2800000 {
			compatible = "apple,s5l-uart", "samsung,s3c6400-uart";
			reg = <0x2800000 0x1000>;
			interrupts = <24>;
			clocks = <&uart_clk>, <&uart_clk>;
			clock-names = "uart", "clk_uart_baud0";
			status = "disabled";
		};

		wdt: timer@f103020 {
			compatible = "apple,s5l8940x-wdt-timer";
			reg = <0xf103020 0x10>;
			interrupts = <4>;
			clock-frequency = <24000000>;
			status = "okay";
		};

		/* The PMU's bus (ADT i2c0, irq 18; Dialog D1815 at 0x74 8-bit = 0x3a).  No child
		 * node yet: only i2c-dev reads it, so no driver writes PMU registers. */
		i2c0: i2c@3200000 {
			compatible = "apple,s5l8940x-i2c";
			reg = <0x3200000 0x1000>;
			clock-frequency = <100000>;
			interrupts = <18>;
			clocks = <&uart_clk>;
			clock-names = "i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
		};

		pmgr: power-management@f100000 {
			compatible = "apple,s5l8940x-pmgr", "syscon";
			reg = <0xf100000 0x7000>;
			status = "disabled";
		};

		/* Audio power states (decoded from the 44-byte device-clocks table): AUDIO
		 * (id 46), I2S (id 47, one gate for every I2S port, child of AUDIO) and
		 * CDMA (id 85).  s5l-hdmi holds all three while bound (one also feeds Ethernet). */
		audio_ps: audio-ps@f10109c {
			compatible = "apple,s5l8940x-pmgr-clk-gate";
			#clock-cells = <0>;
			reg = <0xf10109c 0x4>;
			clocks = <&uart_clk>;
			clock-output-names = "audio_ps";
		};

		i2s_ps: i2s-ps@f1010a0 {
			compatible = "apple,s5l8940x-pmgr-clk-gate";
			#clock-cells = <0>;
			reg = <0xf1010a0 0x4>;
			clocks = <&audio_ps>;
			clock-output-names = "i2s_ps";
		};

		cdma_ps: cdma-ps@f101078 {
			compatible = "apple,s5l8940x-pmgr-clk-gate";
			#clock-cells = <0>;
			reg = <0xf101078 0x4>;
			clocks = <&uart_clk>;
			clock-output-names = "cdma_ps";
		};

		/* HDMI audio: I2S0 sends the samples, slave to the I2S master's clocks
		 * (NCO 0, 342 MHz reference); CDMA channel 0x17 on request 1 (the ADT's
		 * i2s0 dma-channels) feeds it; the HDMI TX's I2S receiver takes them.
		 * The windows: I2S master, I2S0, HDMI CTRL, CORE and I2S receiver, the
		 * PMGR's NCOs, CDMA.  The HDMI TX itself stays iBoot's (the console). */
		hdmi_audio: audio-controller@4190000 {
			compatible = "apple,s5l8947x-hdmi-audio";
			reg = <0x4190000 0x1000>, <0x4195000 0x1000>,
			      <0x9700000 0x1000>, <0x9710000 0x1000>,
			      <0x9740000 0x1000>, <0xf100110 0x70>,
			      <0x7000000 0x2d000>;
			reg-names = "i2s", "i2s-master", "hdmi-ctrl", "hdmi-core",
				    "hdmi-i2s", "nco", "cdma";
			clocks = <&audio_ps>, <&i2s_ps>, <&cdma_ps>;
			clock-names = "audio", "i2s", "cdma";
			apple,dma-channel = <0x17 1>;
			apple,nco-reference-hz = <342000000>;
		};

		otgphy: phy@6000000 {
			compatible = "apple,s5l8940x-otgphy";
			reg = <0x6000000 0x1000>,	/* otgphyctrl */
			      <0xf108000 0x1000>;	/* usb-complex */
			#phy-cells = <1>;
			status = "okay";
		};

		/* EHCI = the host side; the BCM4334 Wi-Fi chip ("monopoly") on HSIC port 2 (ADT
		 * usb0-ehci/wlan port 2; the iPad's is port 3).  No hsic-supply on purpose: REG_ON
		 * is PMU GPIO7 on the D1815, not mapped yet, and a warm handoff from iOS may have
		 * left it high.  PMGR gates match the iPad's offsets (J33i ids 66/67/68 ->
		 * 0x1084/0x1088/0x1090, decoded from the 44-byte device-clocks table). */
		ehci: usb@6400000 {
			compatible = "apple,s5l8940x-ehci", "generic-ehci";
			reg = <0x6400000 0x10000>;
			interrupts = <12>;
			phys = <&otgphy 1>;
			phy-names = "usb";
			apple,hsic-ports = <0x2>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			wifi@2 {
				compatible = "usba5c,bd1a";
				reg = <2>;
				apple,host-ready-gpios = <&gpio 113 0>;
				apple,device-ready-gpios = <&gpio 128 0>;
			};
		};

		/* Arasan FE 10/100 MAC + SMSC LAN8742 PHY at MDIO 0 (ADT ethernet@b000000, irq 27,
		 * clock gate 109 = PMGR +0x1144, which the driver turns on).  No MAC address here: the
		 * real one lives in syscfg; until it is copied in, the driver picks a random one. */
		ethernet@b000000 {
			compatible = "apple,s5l8947x-fe";
			reg = <0xb000000 0x10000>;
			interrupts = <27>;
			status = "okay";
		};

		dwc2: usb@6100000 {
			compatible = "apple,s5l8940x-dwc2", "snps,dwc2";
			reg = <0x6100000 0x10000>;
			interrupts = <11>;
			phys = <&otgphy 0>;
			phy-names = "usb2-phy";
			dr_mode = "peripheral";
			g-rx-fifo-size = <512>;
			g-np-tx-fifo-size = <128>;
			g-tx-fifo-size = <128 128 128 128 128 128 128 128>;
			status = "okay";
		};
	};
};
